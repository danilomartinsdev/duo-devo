# Copie para .env.local e preencha com os valores do painel do Supabase
# (Settings → API). NUNCA faça commit do .env.local.

# URL do projeto (ex.: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave anon (pública — fica no bundle do navegador, por isso a RLS é obrigatória)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role — SÓ SERVIDOR. Nunca use em código que roda no cliente.
SUPABASE_SERVICE_ROLE_KEY=